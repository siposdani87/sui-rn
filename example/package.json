{
  "name": "@siposdani87/sui-rn-example",
  "version": "1.0.0",
  "description": "",
  "author": "Dániel Sipos <siposdani87@gmail.com> (https://siposdani87.com)",
  "license": "MIT",
  "homepage": "https://siposdani87.com",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "keywords": [
    "sui-rn"
  ],
  "files": [
    "src/*",
    "package.json"
  ],
  "scripts": {
    "start": "npx expo start -c",
    "start:dev": "npx expo start --dev-client",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "ios:build": "npx expo run:ios",
    "ios:device": "npx expo run:ios --device",
    "android:build": "npx expo run:android",
    "prebuild": "npx expo prebuild --clean",
    "prebuild:ios": "npx expo prebuild --platform ios --clean",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "pods": "cd ios && pod install",
    "pods:clean": "cd ios && rm -rf Pods Podfile.lock && pod install",
    "clean": "rm -rf node_modules package-lock.json ios/Pods ios/Podfile.lock android/.gradle android/build",
    "clean:cache": "npx expo start -c --clear",
    "type-check": "npx tsc --project . --noEmit",
    "lint": "npx eslint . --ext .ts,.tsx",
    "lint:fix": "npx eslint . --ext .ts,.tsx --fix",
    "format": "npx prettier --write 'src/**/*.ts*'",
    "format:check": "npx prettier --check 'src/**/*.ts*'"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.0",
    "@expo-google-fonts/oswald": "^0.2.0",
    "@expo-google-fonts/ubuntu": "^0.2.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "7.9.0",
    "@siposdani87/expo-maps-polygon-editor": "1.2.1",
    "@siposdani87/expo-rich-text-editor": "1.2.1",
    "@siposdani87/sui-rn": "file:../",
    "date-fns": "4.1.0",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "^13.16.1",
    "react-native-wheel-color-picker": "1.3.1",
    "react-native-worklets": "^0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "^9.39.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^4.1.0",
    "globals": "^16.1.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}

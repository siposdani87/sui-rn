{
  "name": "@siposdani87/sui-rn",
  "version": "1.3.0",
  "description": "This is a basic UI library. It is written in the TypeScript language. The codebase was ready to use with Expo and React Native.",
  "author": "Dániel Sipos <siposdani87@gmail.com> (https://siposdani87.com)",
  "license": "ISC",
  "homepage": "https://siposdani87.com",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/constants/Colors.js",
    "./dist/constants/Styles.js",
    "./dist/constants/Tokens.js"
  ],
  "keywords": [
    "sui-rn"
  ],
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/siposdani87/sui-rn.git"
  },
  "bugs": {
    "url": "https://github.com/siposdani87/sui-rn/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "npm run clean && npm run format && npm run type-check && npm run lint",
    "build": "npx tsc -p .",
    "clean": "rm -rf dist",
    "lint": "npx eslint . --ext .ts,.tsx",
    "lint:fix": "npx eslint . --ext .ts,.tsx --fix",
    "test": "jest",
    "format": "npx prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "npx prettier --check 'src/**/*.{ts,tsx}'",
    "watch": "npm run build -- --watch",
    "type-check": "npx tsc --noEmit",
    "prepare": "husky",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "changelog:first": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "upgrade:packages": "npm install --legacy-peer-deps && cd example && npm install --legacy-peer-deps"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=14.0.0",
    "@react-native-community/datetimepicker": ">=8.0.0",
    "@react-native-community/slider": ">=4.5.0",
    "@siposdani87/expo-rich-text-editor": ">=1.2.0",
    "date-fns": ">=3.0.0",
    "expo-document-picker": ">=12.0.0",
    "expo-file-system": ">=17.0.0",
    "expo-image-picker": ">=15.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0",
    "react-native-maps": ">=1.14.0",
    "react-native-svg": ">=15.0.0",
    "react-native-wheel-color-picker": ">=1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^9.39.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@siposdani87/expo-rich-text-editor": "*",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "conventional-changelog-cli": "^5.0.0",
    "date-fns": "*",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "~54.0.33",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.9",
    "lint-staged": "^16.3.3",
    "prettier": "^3.7.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-svg": "15.12.1",
    "react-native-wheel-color-picker": "*",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}

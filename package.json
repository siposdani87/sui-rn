{
  "name": "@siposdani87/sui-rn",
  "version": "1.0.2",
  "description": "This is a basic UI library. It is written in the TypeScript language. The codebase was ready to use with Expo and React Native.",
  "author": "Dániel Sipos <siposdani87@gmail.com> (https://siposdani87.com)",
  "license": "ISC",
  "homepage": "https://siposdani87.com",
  "private": false,
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "keywords": [
    "sui-rn"
  ],
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/siposdani87/sui-rn.git"
  },
  "bugs": {
    "url": "https://github.com/siposdani87/sui-rn/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "npm run clean && npm run format && npm run lint",
    "build": "npx tsc -p .",
    "clean": "rm -rf dist",
    "lint": "npx eslint . --ext .ts,.tsx",
    "lint:fix": "npx eslint . --ext .ts,.tsx --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "npx prettier --write 'src/**/*.ts*'",
    "format:check": "npx prettier --check 'src/**/*.ts*'",
    "watch": "npm run build -- --watch",
    "type-check": "npx tsc --noEmit",
    "prepare": "npm run build",
    "upgrade:packages": "npm install --legacy-peer-deps && cd example && npm install --legacy-peer-deps"
  },
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "@react-native-community/datetimepicker": "*",
    "@react-native-community/slider": "*",
    "@siposdani87/expo-maps-polygon-editor": "*",
    "@siposdani87/expo-rich-text-editor": "*",
    "date-fns": "*",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-image-picker": "*",
    "react": ">=18.2",
    "react-native": "*",
    "react-native-maps": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "react-native-wheel-color-picker": "*"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.5.1",
    "@react-native-community/slider": "5.1.1",
    "@siposdani87/expo-maps-polygon-editor": "*",
    "@siposdani87/expo-rich-text-editor": "*",
    "date-fns": "*",
    "expo": "^54.0.30",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.26.20",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.15.1",
    "react-native-wheel-color-picker": "*"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "^3.0.1",
    "@types/react": "~19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "@eslint/js": "^9.39.2",
    "@eslint/compat": "^1.2.4"
  }
}
